{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DuckTerm rule record v2 (design draft)",
  "description": "A proposed interchange record. Structural validity does not establish approval authority, scope support, or behavioral enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "status",
    "title",
    "instruction",
    "scope",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "rejected",
        "retired"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "pattern": "\\S"
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "when": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      },
      "maxItems": 8
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "\\S"
      },
      "maxItems": 8
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "audience"
      ],
      "properties": {
        "location": {
          "$ref": "#/$defs/location"
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "model": {
          "$ref": "#/$defs/model"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "model"
            ]
          },
          "then": {
            "properties": {
              "audience": {
                "properties": {
                  "kind": {
                    "const": "harness"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "replaces": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 20
    }
  },
  "$defs": {
    "location": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "global"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "folder_id",
            "include_descendants"
          ],
          "properties": {
            "kind": {
              "const": "folder"
            },
            "folder_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "include_descendants": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "host_id",
            "path",
            "include_descendants"
          ],
          "properties": {
            "kind": {
              "const": "directory"
            },
            "host_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "include_descendants": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "audience": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "everyone"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "harness_id"
          ],
          "properties": {
            "kind": {
              "const": "harness"
            },
            "harness_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "agent_id"
          ],
          "properties": {
            "kind": {
              "const": "agent"
            },
            "agent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "session_key"
          ],
          "properties": {
            "kind": {
              "const": "session"
            },
            "session_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match",
        "value"
      ],
      "properties": {
        "match": {
          "enum": [
            "exact",
            "legacy_contains"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "situation",
        "do"
      ],
      "properties": {
        "situation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "do": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "avoid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "event",
            "annotation",
            "document",
            "legacy_rule"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "references"
      ],
      "properties": {
        "kind": {
          "enum": [
            "manual",
            "correction",
            "digest",
            "retro",
            "import"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 100
        },
        "legacy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "revision",
        "decision"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "retire"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "properties": {
              "decision": {
                "const": "approve"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "properties": {
              "decision": {
                "const": "reject"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "retired"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "properties": {
              "decision": {
                "const": "retire"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "review"
          ]
        }
      }
    }
  ]
}
